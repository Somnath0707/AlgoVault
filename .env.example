# Copy this file to .env. Never commit the real .env file.
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-postgres-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=algovault-api
JWT_AUDIENCE=algovault-extension
JWT_EXPIRATION_MS=86400000
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# The exact Chrome extension origin, for example chrome-extension://your-extension-id
CORS_ALLOWED_ORIGINS=chrome-extension://nglebofiomebgndkkdecnmolafjdphhf
